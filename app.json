{
  "expo": {
    "name": "Cobble",
    "slug": "cobble",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4A7C2F"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cobble.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4A7C2F"
      },
      "package": "com.cobble.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "cobble",
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cobble needs access to your photos to attach images to posts.",
          "cameraPermission": "Cobble needs camera access to snap photos of local issues."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Cobble uses your location to show nearby issues."
        }
      ]
    ]
  }
}
